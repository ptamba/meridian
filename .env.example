# ── Wallet ────────────────────────────────────────────────────────────────────
WALLET_PRIVATE_KEY=your_base58_private_key_here

# ── Solana RPC ─────────────────────────────────────────────────────────────────
RPC_URL=https://mainnet.helius-rpc.com/?api-key=your_helius_api_key_here

# ── LLM Provider ──────────────────────────────────────────────────────────────
# Option A: OpenRouter (default)
OPENROUTER_API_KEY=sk-or-your_openrouter_key_here

# Option B: LM Studio (local) — uncomment these and comment out OPENROUTER_API_KEY
# LLM_BASE_URL=http://localhost:1234/v1
# LLM_API_KEY=lm-studio
# LLM_MODEL=your-model-name-from-lmstudio

# Option C: DeepSeek (api.deepseek.com — OpenAI-compatible)
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_API_KEY=sk-your_deepseek_key_here
# LLM_MODEL=deepseek-v4-flash         # or deepseek-v4-pro

# ── API Keys ───────────────────────────────────────────────────────────────────
HELIUS_API_KEY=your_helius_api_key_here
LPAGENT_API_KEY=your_lpagent_api_key_here

# Optional: Jupiter Ultra API key (improved rate limits). Leave blank for
# anonymous public-tier access.
JUPITER_API_KEY=

# ── Telegram Notifications (optional) ─────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALLOWED_USER_IDS=
# Optional: forum supergroup topic id. Set to scope the bot to one topic.
TELEGRAM_THREAD_ID=

# ── HiveMind (opt-in) ─────────────────────────────────────────────────────────
# HiveMind is disabled by default. To enable, set hiveMindUrl + hiveMindApiKey
# in user-config.json, or set the api key here.
HIVEMIND_API_KEY=

# ── Dangerous admin actions (disabled by default) ─────────────────────────────
ALLOW_SELF_UPDATE=false

# ── Misc ───────────────────────────────────────────────────────────────────────
DRY_RUN=false
LOG_LEVEL=info

# ── Strategy overrides (optional) ─────────────────────────────────────────────
# Priority for every key below: user-config.json > this env file > hardcoded
# default shown after each name. Leave commented to use the default.
#
# Trailing take-profit confirmation
# TRAILING_PEAK_CONFIRM_DELAY_MS=15000        # wait before confirming a new PnL peak
# TRAILING_PEAK_CONFIRM_TOLERANCE=0.85        # confirm peak if new sample >= peak * tolerance
# TRAILING_DROP_CONFIRM_DELAY_MS=15000        # wait before confirming a trailing drop
# TRAILING_DROP_CONFIRM_TOLERANCE_PCT=1.0     # confirm drop if it stayed within this band
#
# Cooldown after low-yield close
# LOW_YIELD_COOLDOWN_HOURS=4                  # 0 disables the cooldown
#
# Threshold-evolution learner
# LESSONS_MIN_EVOLVE_POSITIONS=5              # closed positions required before evolving
# LESSONS_MAX_CHANGE_PER_STEP=0.20            # max relative shift per evolution cycle
#
# Swap / slippage (basis points unless suffixed with Pct)
# DEPLOY_RELAY_SLIPPAGE_BPS=500               # Jupiter zap-in via relay (0.5%)
# ADD_LIQUIDITY_WIDE_RANGE_PCT=10             # Meteora wide-range path (percent)
# ADD_LIQUIDITY_STANDARD_BPS=1000             # Meteora standard path (10%)
# LIQUIDATION_SLIPPAGE_BPS=5000               # close-position liquidation swap (5%)
